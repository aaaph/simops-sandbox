<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>px4_companion</name>
  <version>0.1.0</version>
  <description>
    Nodes for the companion computer of a PX4 vehicle, shared by every platform:
    PX4 odometry on /odom and tf, and the fixed sensor frames of the platform model.
  </description>
  <maintainer email="nekaktotak2@gmail.com">Ivan Aphanasyev</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
